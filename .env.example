# ============================================================
# RepoPilot — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ----------- Database -----------
# Supabase: Connection string (Pooler mode)
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# ----------- IBM Bob 2.0 -----------
# Bob is accessed via Bob Shell CLI, not a REST API.
# These values are for logging and workspace setup only.
BOB_SHELL_PATH=bob
BOB_WORKSPACE_ROOT=/tmp/repopilot

# ----------- Fallback LLM (optional) -----------
# Only used if Bob Shell is unavailable.
OPENAI_API_KEY=sk-...

# ----------- GitHub (optional) -----------
# Required only for private repositories.
GITHUB_TOKEN=ghp_...

# ----------- Monitoring -----------
SENTRY_DSN=https://...@sentry.io/...

# ----------- Frontend -----------
NEXT_PUBLIC_API_URL=http://localhost:8000
